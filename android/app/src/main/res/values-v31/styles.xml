<resources>

    <!-- Android 12+ (API 31+) overrides the classic android:windowBackground
         cold-start splash with the platform SplashScreen API. It shows the
         adaptive launcher icon on windowSplashScreenBackground, so without the
         attributes below the background falls back to system white and the
         bootsplash.xml layer-list is ignored. Keep this in sync with
         res/drawable/bootsplash.xml and src/components/AppLoader.js.
         Only the launch theme is overridden here - AppTheme comes from
         values/styles.xml on every API level and carries no splash of its own,
         so nothing branded is left behind the app once MainActivity swaps the
         window background at first render. -->
    <style name="BootTheme" parent="AppTheme">
        <!-- Legacy fallback (ignored on 12+, kept so the pre-31 path and this
             one stay identical; harmless here). -->
        <item name="android:windowBackground">@drawable/bootsplash</item>
        <!-- Branded system splash instead of the default white window. -->
        <item name="android:windowSplashScreenBackground">@color/bootsplash_background</item>
               <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

</resources>
